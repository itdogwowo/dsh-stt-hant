{
  "name": "dsh-stt-hant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Traditional Chinese transcriptions for the DSH speech input, with a sidebar test console",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "native",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "scripts": {
    "test": "node --test"
  },
  "dependencies": {
    "opencc-js": "^1.4.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-experimental-client-ui-voice-input"
      ]
    }
  }
}
